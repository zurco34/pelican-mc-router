# Container timezone
TZ=Europe/Oslo

# Public Minecraft listener
MINECRAFT_BIND_ADDRESS=0.0.0.0
MINECRAFT_PORT=25565

# Pelican MC Router HTTP API
#
# The default only exposes the API to the Docker host itself.
PELICAN_MC_ROUTER_BIND_ADDRESS=127.0.0.1
PELICAN_MC_ROUTER_HTTP_PORT=8080

# Inbound HTTP API timeouts. Keep values positive and increase them only for
# known long-running API clients.
PELICAN_MC_ROUTER_SERVER_READ_HEADER_TIMEOUT=5s
PELICAN_MC_ROUTER_SERVER_READ_TIMEOUT=15s
PELICAN_MC_ROUTER_SERVER_WRITE_TIMEOUT=30s
PELICAN_MC_ROUTER_SERVER_IDLE_TIMEOUT=1m

# Retry only transient failures for Pelican and mc-router read requests.
PELICAN_MC_ROUTER_RETRY_ATTEMPTS=3
PELICAN_MC_ROUTER_RETRY_INITIAL_BACKOFF=200ms
PELICAN_MC_ROUTER_RETRY_MAX_BACKOFF=2s

# Fallback destination for Pelican allocations bound to 0.0.0.0 or ::.
#
# Leave empty when all allocation IPs are directly routable from mc-router.
# The value must be reachable from inside the mc-router container.
PELICAN_MC_ROUTER_DISCOVERY_WILDCARD_BACKEND_HOST=

# Container images
MC_ROUTER_IMAGE=docker.io/itzg/mc-router:1.44.0

# Pin the exact Pelican MC Router release used by this deployment.
PELICAN_MC_ROUTER_IMAGE=ghcr.io/zurco34/pelican-mc-router:0.1.3

# Local source-build metadata
PELICAN_MC_ROUTER_VERSION=dev
PELICAN_MC_ROUTER_REVISION=unknown

# Logging
MC_ROUTER_LOG_LEVEL=info
PELICAN_MC_ROUTER_LOG_LEVEL=info
